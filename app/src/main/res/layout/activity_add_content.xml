<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF"
            android:contentDescription="Volver"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvAddTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agregar contenido"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack" />

        <EditText
            android:id="@+id/etContentTitle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_edittext"
            android:hint="Título del contenido"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            app:layout_constraintTop_toBottomOf="@id/tvAddTitle" />

        <Spinner
            android:id="@+id/spType"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:background="@android:drawable/btn_dropdown"
            app:layout_constraintEnd_toStartOf="@+id/spGenre"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etContentTitle" />

        <Spinner
            android:id="@+id/spGenre"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@android:drawable/btn_dropdown"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/spType"
            app:layout_constraintTop_toBottomOf="@id/etContentTitle" />

        <LinearLayout
            android:id="@+id/llMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/spType">

            <EditText
                android:id="@+id/etYear"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_edittext"
                android:hint="Año"
                android:inputType="number"
                android:paddingStart="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />

            <EditText
                android:id="@+id/etDuration"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edittext"
                android:hint="Duración"
                android:paddingStart="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />
        </LinearLayout>

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_edittext"
            android:gravity="top"
            android:hint="Descripción"
            android:padding="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            app:layout_constraintTop_toBottomOf="@id/llMeta" />

        <EditText
            android:id="@+id/etDirector"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_edittext"
            android:hint="Nombre del director"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            app:layout_constraintTop_toBottomOf="@id/etDescription" />

        <!-- Sección de Multimedia -->
        <TextView
            android:id="@+id/tvMediaHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Archivos de Multimedia"
            android:textColor="#E5A645"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etDirector" />

        <LinearLayout
            android:id="@+id/llPosterInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvMediaHeader">

            <ImageView
                android:id="@+id/ivPosterPreview"
                android:layout_width="50dp"
                android:layout_height="75dp"
                android:background="#1A1A1A"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="Vista previa portada" />

            <EditText
                android:id="@+id/etImageUrl"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edittext"
                android:hint="URL del Poster / Imagen"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />
        </LinearLayout>

        <EditText
            android:id="@+id/etVideoUrl"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_edittext"
            android:hint="URL del Video / Trailer"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            app:layout_constraintTop_toBottomOf="@id/llPosterInput" />

        <CheckBox
            android:id="@+id/cbProcessing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Marcar como 'En procesamiento' (Ocultar reproducción a usuarios)"
            android:textColor="#E5A645"
            app:layout_constraintTop_toBottomOf="@id/etVideoUrl" />

        <!-- Sección de Capítulos para Series -->
        <LinearLayout
            android:id="@+id/llSeriesSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/cbProcessing">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Capítulos de la Serie"
                android:textColor="#E5A645"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etEpSeason"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="Temp #"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888" />

                <EditText
                    android:id="@+id/etEpNumber"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edittext"
                    android:hint="Cap #"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888" />
            </LinearLayout>

            <EditText
                android:id="@+id/etEpTitle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edittext"
                android:hint="Título del capítulo"
                android:paddingStart="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />

            <EditText
                android:id="@+id/etEpVideoUrl"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edittext"
                android:hint="URL del video del capítulo"
                android:paddingStart="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etEpDuration"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="Duración (ej: 45m)"
                    android:paddingStart="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888" />

                <EditText
                    android:id="@+id/etEpImageUrl"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="2"
                    android:background="@drawable/bg_edittext"
                    android:hint="URL Imagen del capítulo"
                    android:paddingStart="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAddEpisode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#333333"
                android:text="＋ Agregar Capítulo"
                android:textColor="#FFFFFF" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAddedEpisodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        </LinearLayout>

        <Button
            android:id="@+id/btnSaveContent"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#E5A645"
            android:text="Guardar contenido"
            android:textColor="#000000"
            app:layout_constraintTop_toBottomOf="@id/llSeriesSection" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

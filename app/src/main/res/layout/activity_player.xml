<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Reproductor de Video Nativo ExoPlayer (Media3) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        app:resize_mode="fit"
        app:show_buffering="always"
        app:use_controller="true"
        android:visibility="gone" />

    <!-- Reproductor Web -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <!-- Carga -->
    <ProgressBar
        android:id="@+id/pbPlayerLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminateTint="#E5A645" />

    <!-- Botón Volver solo visible en vertical (tamaño accesible 48dp) -->
    <ImageButton
        android:id="@+id/btnPlayerBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="8dp"
        android:background="#80000000"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#FFFFFF"
        android:contentDescription="@string/back_button" />

    <!-- Tapa el botón "abrir en pestaña" [↗] de Drive -->
    <View
        android:id="@+id/blockPopout"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:importantForAccessibility="no" />

</RelativeLayout>
